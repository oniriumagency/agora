{
  "name": "kubox-meet",
  "version": "1.0.0",
  "private": true,
  "description": "Reuniones por vídeo con servidor propio (SFU en un .exe): chat, mano alzada y pantalla compartida",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/desarrollo.mjs",
    "dev:web": "next dev -p 3100",
    "servidor": "go run ./servidor-go --sin-tunel --sin-upnp --sin-firewall --sin-navegador",
    "build": "next build",
    "exe": "node scripts/construirServidor.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "cd servidor-go && go test ./...",
    "test:e2e": "node pruebas/e2e.cjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
