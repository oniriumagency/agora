{
  "name": "kubox-meet",
  "version": "1.0.0",
  "private": true,
  "description": "Videoconferencias P2P (WebRTC) con chat, mano alzada y pantalla compartida",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/desarrollo.mjs",
    "dev:web": "next dev -p 3100",
    "servidor": "node servidor/src/servidor.ts",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p servidor",
    "test": "node --test servidor/test/servidor.test.ts",
    "test:e2e": "node pruebas/e2e.cjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
