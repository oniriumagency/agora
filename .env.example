# Plantilla de variables de entorno de Kubox Meet. Copiar como ".env.local" (ignorado por git).

# --- Servidor de señalización (lo leen `npm run servidor` y el servicio de systemd) ---
# Puerto del WebSocket (por defecto 8180).
PUERTO=8180
# TURN de Cloudflare Realtime (recomendado con CGNAT o datos móviles). El servidor pide credenciales
# temporales y se las da a cada participante; el token nunca llega al navegador. Puedes usar la misma
# clave TURN que Kubox: Cloudflare > Realtime > TURN Server ("Turn Token ID" y "API Token").
MEET_TURN_CLOUDFLARE_ID=
MEET_TURN_CLOUDFLARE_TOKEN=
# Vida de las credenciales en segundos (mínimo 600; por defecto 86400 = 24 h).
MEET_TURN_TTL_SEGUNDOS=
# Orígenes de navegador admitidos, separados por comas (vacío = cualquiera, con aviso).
MEET_ORIGENES_PERMITIDOS=
# true solo detrás de un proxy que fija X-Forwarded-For (p. ej. cloudflared).
MEET_CONFIAR_PROXY=false
MEET_MAXIMO_POR_SALA=8
MEET_MAXIMO_SALAS=200
MEET_MAXIMO_CONEXIONES=500
MEET_MAXIMO_CONEXIONES_POR_IP=20

# --- Web (Next.js, se inyecta al compilar) ---
# Vacío = en desarrollo ws://<equipo>:8180 y en producción wss://<mismo dominio>/senal.
NEXT_PUBLIC_URL_SENALIZACION=
# TURN fijo alternativo, solo si el servidor no envía credenciales (llegan al navegador).
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USUARIO=
NEXT_PUBLIC_TURN_CLAVE=
