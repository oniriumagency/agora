# Configuración de Ágora. En Windows: junto a AgoraServidor.exe, con el nombre agora.env.
# En un servidor Ubuntu: /opt/agora/agora.env (el instalador lo crea).

# TURN de Cloudflare Realtime. Imprescindible tras CGNAT: el vídeo pasa por el relé de Cloudflare.
# Panel de Cloudflare > Realtime > TURN Server: "Turn Token ID" y "API Token".
MEET_TURN_CLOUDFLARE_ID=
MEET_TURN_CLOUDFLARE_TOKEN=

# Dirección pública. En un servidor: el subdominio publicado por tu Cloudflare Tunnel (o tu proxy).
# Vacío = el servidor abre un túnel rápido de trycloudflare (lo que hace el .exe de Windows).
MEET_URL_PUBLICA=

# Puertos: web y señalización (HTTP), HTTPS de red local y medios (UDP y TCP).
MEET_PUERTO_WEB=8090
MEET_PUERTO_HTTPS=8443
MEET_PUERTO_MEDIOS=8091

# Personas por reunión, vídeos de cámara que recibe cada una a la vez y tamaño máximo de archivo.
MEET_MAXIMO_POR_SALA=100
MEET_MAXIMO_VIDEOS=9
MEET_MAXIMO_ARCHIVO_MB=95
