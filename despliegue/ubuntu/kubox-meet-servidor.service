# Servidor de Kubox Meet (web + señalización + SFU) en el Ubuntu de casa, detrás del Cloudflare Tunnel.
[Unit]
Description=Kubox Meet - servidor de reuniones
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kubox-meet
Group=kubox-meet
WorkingDirectory=/opt/kubox-meet
# Lee /opt/kubox-meet/kubox-meet.env (dominio público y TURN de Cloudflare).
ExecStart=/opt/kubox-meet/kubox-meet-servidor-linux --sin-tunel --sin-navegador --puerto-https 0
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CacheDirectory=KuboxMeet
Environment=XDG_CACHE_HOME=/var/cache

[Install]
WantedBy=multi-user.target
