# Configuración del despliegue de Kubox Meet en Ubuntu. Copiar a /etc/kubox-meet/despliegue.env:
#   sudo install -D -m 600 despliegue.env.example /etc/kubox-meet/despliegue.env

# Dominio público, publicado por el Cloudflare Tunnel que ya usa Kubox (un nivel de subdominio,
# para que lo cubra el certificado gratuito).
MEET_DOMINIO=meet.onirium.agency

# TURN de Cloudflare Realtime: puede ser la misma clave que usa Kubox.
MEET_TURN_CLOUDFLARE_ID=
MEET_TURN_CLOUDFLARE_TOKEN=

# Personas por reunión. En malla cada una envía su vídeo a todas las demás: más de 8 exige mucha subida.
MEET_MAXIMO_POR_SALA=8
