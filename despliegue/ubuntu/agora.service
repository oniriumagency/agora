# Ágora (web + señalización + servidor de vídeo) en un servidor Ubuntu, detrás de un Cloudflare Tunnel o un proxy.
[Unit]
Description=Ágora - servidor de reuniones
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agora
Group=agora
WorkingDirectory=/opt/agora
# Lee /opt/agora/agora.env (URL pública y TURN de Cloudflare).
ExecStart=/opt/agora/agora-servidor-linux --sin-tunel --sin-navegador --sin-firewall --sin-upnp --puerto-https 0
Restart=always
RestartSec=3
# Aislamiento: el servicio solo puede abrir sockets de red y escribir en su caché.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
CacheDirectory=Agora
Environment=XDG_CACHE_HOME=/var/cache
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
