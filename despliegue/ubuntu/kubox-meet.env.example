# Configuración del servidor de Kubox Meet. En Windows: copia este archivo junto a
# KuboxMeetServidor.exe con el nombre kubox-meet.env. En Ubuntu: /opt/kubox-meet/kubox-meet.env

# TURN de Cloudflare Realtime (la misma clave que Kubox sirve). Imprescindible si el servidor está
# tras CGNAT: el vídeo pasa entonces por el relé de Cloudflare. Panel de Cloudflare > Realtime >
# TURN Server: "Turn Token ID" y "API Token".
MEET_TURN_CLOUDFLARE_ID=
MEET_TURN_CLOUDFLARE_TOKEN=

# URL pública propia (p. ej. tu Cloudflare Tunnel con dominio). Vacío = túnel rápido trycloudflare.
MEET_URL_PUBLICA=

# Puertos: web y señalización (HTTP), HTTPS de red local y medios (UDP y TCP).
MEET_PUERTO_WEB=8090
MEET_PUERTO_HTTPS=8443
MEET_PUERTO_MEDIOS=8091

# Personas por reunión y vídeos de cámara que recibe cada una a la vez (el resto, al pasar de página).
MEET_MAXIMO_POR_SALA=100
MEET_MAXIMO_VIDEOS=9
